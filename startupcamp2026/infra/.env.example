# Copy to infra/.env and fill every required value. Compose refuses to start
# when a required secret is empty. Generate one with: openssl rand -base64 36
#
#   cp infra/.env.example infra/.env

# --- Postgres (bundled compose only) --------------------------------------
POSTGRES_PASSWORD=
CORE_DB_PASSWORD=
NOTIFIER_DB_PASSWORD=

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_USER=otmetka
RABBITMQ_PASSWORD=

# --- Redis (optional password; leave empty for the bundled Redis) ---------
REDIS_PASSWORD=

# --- core -----------------------------------------------------------------
# At least 32 characters. Signs access tokens (HS256).
JWT_SECRET=
# Shared secret for the one internal call, core -> notifier. At least 16 characters.
INTERNAL_SECRET=
PREMIUM_ENFORCED=true
# true creates six demo accounts with passwords written in the repository.
# Leave false on any server that is reachable.
SEED_TEST_ACCOUNTS=false
# Address of the web client as users see it; used for links in emails.
WEB_BASE_URL=http://localhost:5173

# --- External Postgres / Redis / RabbitMQ (docker-compose.external.yml) ---
# JDBC URL for core. Bundled compose defaults to postgres:5432 in the same stack.
# DATABASE_URL=jdbc:postgresql://postgres:5432/otmetka
# DATABASE_USER=core
# DATABASE_PASSWORD=   # same as CORE_DB_PASSWORD when using bundled Postgres
# REDIS_HOST=redis
# REDIS_PORT=6379
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672
# Python URL for notifier:
# NOTIFIER_DATABASE_URL=postgresql+psycopg://notifier:PASSWORD@postgres:5432/otmetka
# RABBITMQ_URL=amqp://otmetka:PASSWORD@rabbitmq:5672/
# Join another stack's network:
# OTMETKA_NETWORK=dokploy-postgres-net
# OTMETKA_NETWORK_EXTERNAL=true

# --- Email (core) -----------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL=false
MAIL_FROM=no-reply@otmetka.local

# --- Alerts and push (notifier) ----------------------------------------------
ALERT_GRACE_MINUTES=30
ALERT_POLL_SECONDS=30
PUSH_DRY_RUN=true
FCM_SERVICE_ACCOUNT_FILE=
RUSTORE_PROJECT_ID=
RUSTORE_SERVICE_TOKEN=

# --- Production overlay (docker-compose.prod.yml) ---------------------------
# DOMAIN=otmetka.example.ru
